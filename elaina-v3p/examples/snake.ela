# SNAKE GAME - Written in Elaina v3
# Controls: W A S D
# Exit: Ctrl+C

# Config
let ROWS = 20
let COLS = 40
let FPS  = 9

# Box drawing chars as variables (unicode must be inside strings)
let CH_TL = "╔"
let CH_TR = "╗"
let CH_BL = "╚"
let CH_BR = "╝"
let CH_HZ = "═"
let CH_VT = "║"
let CH_HD = "█"
let CH_BD = "▓"
let CH_FD = "◆"
let CH_EM = " "

# Game state
let snakeBody  = [[10, 10], [10, 9], [10, 8]]
let dirRow     = 0
let dirCol     = 1
let foodRow    = 5
let foodCol    = 20
let score      = 0
let hiScore    = 0
let alive      = true
let paused     = false

# Spawn food at random position
spell spawnFood():
    foodRow = randint(1, ROWS - 2)
    foodCol = randint(1, COLS - 2)

# Check if position is on snake body
spell onSnake(r, c):
    loop seg in snakeBody:
        if seg[0] == r and seg[1] == c:
            give back true
    give back false

# Draw the board
spell drawBoard():
    clearScreen()
    loop r from 0 to ROWS - 1:
        loop c from 0 to COLS - 1:
            let ch = CH_EM

            if r == 0:
                if c == 0:
                    ch = CH_TL
                elif c == COLS - 1:
                    ch = CH_TR
                else:
                    ch = CH_HZ
            elif r == ROWS - 1:
                if c == 0:
                    ch = CH_BL
                elif c == COLS - 1:
                    ch = CH_BR
                else:
                    ch = CH_HZ
            elif c == 0 or c == COLS - 1:
                ch = CH_VT
            elif r == foodRow and c == foodCol:
                ch = CH_FD
            elif snakeBody[0][0] == r and snakeBody[0][1] == c:
                ch = CH_HD
            else:
                loop seg in snakeBody:
                    if seg[0] == r and seg[1] == c:
                        ch = CH_BD

            rawPrint(ch)
        rawPrint("\n")

    rawPrint("  Score: " + score + "  |  Best: " + hiScore + "  |  WASD=move  P=pause  Ctrl+C=quit\n")

# Draw game over screen
spell drawGameOver():
    clearScreen()
    rawPrint("\n\n")
    rawPrint("  +--------------------------+\n")
    rawPrint("  |       GAME  OVER         |\n")
    rawPrint("  +--------------------------+\n")
    rawPrint("  |  Score : " + score + "\n")
    rawPrint("  |  Best  : " + hiScore + "\n")
    rawPrint("  +--------------------------+\n")
    rawPrint("  |  Ctrl+C to quit          |\n")
    rawPrint("  +--------------------------+\n")

# Handle keyboard input
spell handleInput():
    let k = getKey()
    if k == nothing:
        give back nothing
    clearKey()

    if k == "w" or k == "up":
        if dirRow != 1:
            dirRow = -1
            dirCol = 0
    elif k == "s" or k == "down":
        if dirRow != -1:
            dirRow = 1
            dirCol = 0
    elif k == "a" or k == "left":
        if dirCol != 1:
            dirRow = 0
            dirCol = -1
    elif k == "d" or k == "right":
        if dirCol != -1:
            dirRow = 0
            dirCol = 1
    elif k == "p":
        if paused:
            paused = false
        else:
            paused = true

# Move snake one step
spell moveSnake():
    let head   = snakeBody[0]
    let newRow = head[0] + dirRow
    let newCol = head[1] + dirCol

    if newRow <= 0 or newRow >= ROWS - 1 or newCol <= 0 or newCol >= COLS - 1:
        alive = false
        give back nothing

    let bodyLen = len(snakeBody)
    let i = 0
    while i < bodyLen - 1:
        let seg = snakeBody[i]
        if seg[0] == newRow and seg[1] == newCol:
            alive = false
            give back nothing
        i += 1

    snakeBody.push(nothing)
    let j = len(snakeBody) - 1
    while j > 0:
        snakeBody[j] = snakeBody[j - 1]
        j -= 1
    snakeBody[0] = [newRow, newCol]

    if newRow == foodRow and newCol == foodCol:
        score += 10
        if score > hiScore:
            hiScore = score
        cast spawnFood()
        while onSnake(foodRow, foodCol):
            cast spawnFood()
    else:
        snakeBody.pop()

# Main tick
spell tick():
    cast handleInput()
    if not alive:
        cast drawGameOver()
        give back nothing
    if paused:
        give back nothing
    cast moveSnake()
    cast drawBoard()

# Start
cast spawnFood()
cast drawBoard()
__startGameLoop__(tick, FPS)
