# ─────────────────────────────────────
# 1. HELLO WORLD
# ─────────────────────────────────────

say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
say "✦ 1. Hello World"
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

say "Hello, World!"
say "Welcome to Elaina v3 ✦"


# ─────────────────────────────────────
# 2. VARIABLES, TYPES & MATH
# ─────────────────────────────────────

say ""
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
say "✦ 2. Variables & Math"
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

let x = 42
let y = 3.14
let name = "Elaina"
let flag = true

say "Integer: " + x
say "Float:   " + y
say "String:  " + name
say "Boolean: " + flag
say "PI:      " + PI

let area = PI * 5 ** 2
say "Circle area (r=5): " + area

let counter = 0
counter += 10
counter -= 3
say "Counter: " + counter


# ─────────────────────────────────────
# 3. CONDITIONALS (if / elif / else)
# ─────────────────────────────────────

say ""
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
say "✦ 3. Conditionals"
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

let score = 87

if score >= 90:
    say "Grade: A — Outstanding!"
elif score >= 80:
    say "Grade: B — Great work!"
elif score >= 70:
    say "Grade: C — Decent effort."
else:
    say "Grade: D — Keep practicing."

let weather = "sunny"
let mood    = "good"

if weather == "sunny" and mood == "good":
    say "Perfect day for adventure!"
elif weather == "sunny" or mood == "good":
    say "Not bad at all."
else:
    say "Stay inside today."


# ─────────────────────────────────────
# 4. LOOPS — range, in, while
# ─────────────────────────────────────

say ""
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
say "✦ 4. Loops"
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Range loop
say "Squares from 1 to 5:"
loop i from 1 to 5:
    say "  " + i + "² = " + i ** 2

# Loop over list
let fruits = ["apple", "mango", "lychee", "starfruit"]
say "Fruits:"
loop fruit in fruits:
    say "  » " + fruit

# While with break
say "Even numbers < 10:"
let n = 0
while n < 10:
    n += 1
    if n % 2 != 0:
        continue
    say "  " + n

# FizzBuzz (classic)
say "FizzBuzz 1-15:"
loop i from 1 to 15:
    if i % 15 == 0:
        say "  FizzBuzz"
    elif i % 3 == 0:
        say "  Fizz"
    elif i % 5 == 0:
        say "  Buzz"
    else:
        say "  " + i


# ─────────────────────────────────────
# 5. SPELLS (Functions)
# ─────────────────────────────────────

say ""
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
say "✦ 5. Spells (Functions)"
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

spell greet(name):
    say "Hello, " + name + "! Welcome to Elaina."

cast greet("Adventurer")
cast greet("Elaina")

spell add(a, b):
    give back a + b

spell multiply(a, b):
    give back a * b

say "7 + 8 = " + add(7, 8)
say "6 × 7 = " + multiply(6, 7)

# Recursive factorial
spell factorial(n):
    if n <= 1:
        give back 1
    give back n * factorial(n - 1)

loop i from 1 to 8:
    say i + "! = " + factorial(i)

# Higher-order: spell returning a spell
spell makeMultiplier(factor):
    spell multiplier(x):
        give back x * factor
    give back multiplier

let triple = makeMultiplier(3)
say "Triple 7: " + triple(7)
say "Triple 9: " + triple(9)


# ─────────────────────────────────────
# 6. LISTS
# ─────────────────────────────────────

say ""
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
say "✦ 6. Lists"
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

let nums = [10, 3, 7, 1, 9, 4, 6, 2, 8, 5]

say "Original: " + nums
say "Length:   " + len(nums)
say "First:    " + nums[0]
say "Last:     " + nums[-1]

let sorted = nums.sort()
say "Sorted:   " + sorted

nums.push(99)
say "After push: " + nums

let popped = nums.pop()
say "Popped: " + popped

# Sum and average
let total = 0
loop n in nums:
    total += n
say "Sum: " + total
say "Avg: " + total / len(nums)

# List comprehension style with loop
let squares = []
loop i from 1 to 5:
    squares.push(i * i)
say "Squares: " + squares


# ─────────────────────────────────────
# 7. DICTS
# ─────────────────────────────────────

say ""
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
say "✦ 7. Dicts (Maps)"
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

let hero = {"name": "Elaina", "level": 15, "class": "Mage"}

say "Hero name:  " + hero["name"]
say "Hero level: " + hero["level"]

hero["level"] = 16
hero["guild"] = "Wanderers"

say "Updated hero: " + hero
say "Keys: " + hero.keys()

# Check membership
if hero.has("guild"):
    say "Guild: " + hero["guild"]


# ─────────────────────────────────────
# 8. ENCHANT (Classes / Objects)
# ─────────────────────────────────────

say ""
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
say "✦ 8. Enchant (Classes)"
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

enchant Animal:
    spell init(name, sound):
        self.name  = name
        self.sound = sound

    spell speak():
        say self.name + " says: " + self.sound + "!"

    spell describe():
        give back "I am " + self.name

enchant Dog from Animal:
    spell init(name):
        self.name  = name
        self.sound = "Woof"
        self.tricks = []

    spell learnTrick(trick):
        self.tricks.push(trick)
        say self.name + " learned: " + trick

    spell showTricks():
        say self.name + "'s tricks:"
        loop t in self.tricks:
            say "  ✓ " + t

let cat = Animal("Whiskers", "Meow")
cast cat.speak()
say cat.describe()

let dog = Dog("Rex")
cast dog.speak()
cast dog.learnTrick("sit")
cast dog.learnTrick("roll over")
cast dog.learnTrick("fetch")
cast dog.showTricks()

# Inventory system with a class
enchant Inventory:
    spell init():
        self.items = []
        self.gold  = 0

    spell addItem(item):
        self.items.push(item)
        say "Added: " + item

    spell addGold(amount):
        self.gold += amount
        say "Gold: " + self.gold

    spell status():
        say "Items: " + self.items
        say "Gold:  " + self.gold

let bag = Inventory()
cast bag.addItem("Health Potion")
cast bag.addItem("Magic Scroll")
cast bag.addItem("Iron Sword")
cast bag.addGold(150)
cast bag.status()


# ─────────────────────────────────────
# 9. ERROR HANDLING (try / catch / raise)
# ─────────────────────────────────────

say ""
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
say "✦ 9. Error Handling"
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

spell safeDivide(a, b):
    if b == 0:
        raise "Cannot divide by zero!"
    give back a / b

try:
    let result = safeDivide(10, 2)
    say "10 / 2 = " + result
catch err:
    say "Error: " + err

try:
    let bad = safeDivide(10, 0)
    say "Should not reach here"
catch err:
    say "Caught: " + err

# Nested try/catch
spell riskyOperation(val):
    if val < 0:
        raise "Negative values forbidden"
    if val > 100:
        raise "Value too large (max 100)"
    give back val * 2

let testVals = [-5, 50, 200, 30]
loop v in testVals:
    try:
        let r = riskyOperation(v)
        say "riskyOp(" + v + ") = " + r
    catch e:
        say "riskyOp(" + v + ") failed: " + e


# ─────────────────────────────────────
# 10. STRING OPERATIONS
# ─────────────────────────────────────

say ""
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
say "✦ 10. String Operations"
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

let greeting = "Hello, Elaina World!"

say upper(greeting)
say lower(greeting)
say "Length: " + len(greeting)
say "Contains 'Elaina': " + contains(greeting, "Elaina")

let words = split(greeting, " ")
say "Words: " + words
say "Joined: " + join(words, "-")

let template = "Hello, {}! You are level {}."
say format(template, "Hero", 42)


# ─────────────────────────────────────
# 11. FIBONACCI + MEMOIZATION (Advanced)
# ─────────────────────────────────────

say ""
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
say "✦ 11. Fibonacci with Memoization"
say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

let memo = {}

spell fib(n):
    if memo.has(n):
        give back memo.get(n)
    if n <= 1:
        give back n
    let result = fib(n - 1) + fib(n - 2)
    memo.set(n, result)
    give back result

say "Fibonacci sequence (0-15):"
loop i from 0 to 15:
    say "  fib(" + i + ") = " + fib(i)


